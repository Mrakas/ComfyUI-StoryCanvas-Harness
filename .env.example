# OpenAI planning, factual web search, and image generation
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional image-oriented search. Fact search uses OpenAI web_search by default.
SERPER_API_KEY=

# MiniMax-H3-compatible HTTP service. Paid video calls remain locked unless
# ExecutionPolicy.mode=full AND allow_paid_video=true.
MINIMAX_H3_API_KEY=
MINIMAX_H3_BASE_URL=
MINIMAX_H3_MODEL=MiniMax-H3

# Optional experimental local Codex app-server provider. It reuses the current
# `codex login` ChatGPT session and never reads or copies auth.json.
STORYCANVAS_PROVIDER_MODE=openai
STORYCANVAS_CODEX_ENABLED=false
STORYCANVAS_CODEX_MODEL=gpt-5.6-sol
STORYCANVAS_CODEX_REASONING_EFFORT=medium
STORYCANVAS_CODEX_BIN=codex

# All generated artifacts live below this directory.
STORYCANVAS_RUNS_DIR=./runs
